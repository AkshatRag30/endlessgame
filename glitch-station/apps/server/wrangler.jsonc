{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "glitch-station",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-01",
  "observability": { "enabled": true },

  // The built client (apps/client/dist) is served by this same Worker, so the
  // game page and the room servers share one free *.workers.dev address.
  // Requests for /ws, /api and /health run the Worker code first.
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws", "/api/*", "/health"]
  },

  // One Durable Object instance per room, addressed by room code (PRD section 10).
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomServer" }]
  },

  // SQLite backed classes are the kind available on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomServer"] }],

  // Not secret. Leave empty to allow any site, or list your game address(es).
  "vars": { "ALLOWED_ORIGINS": "" }
}
